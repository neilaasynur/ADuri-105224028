# .env.example — Template environment variable
# Salin file ini menjadi .env.local lalu isi nilainya
# File ini AMAN untuk di-commit (tidak berisi nilai asli)

# Kunci enkripsi AES-256-GCM (WAJIB tepat 32 karakter)
ENCRYPTION_KEY=isi-dengan-32-karakter-acak-kamu

# Secret untuk HMAC integritas pesanan
HMAC_SECRET=isi-dengan-string-acak-panjang-untuk-hmac
